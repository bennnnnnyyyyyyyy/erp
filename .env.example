# Copy to .env (git-ignored) at the repo root. Both apps read it in local development:
#   apps/api via `wrangler dev --env-file ../../.env`
#   apps/web via apps/web/vite.config.ts (only the URL and publishable key reach the browser)
# Values: Supabase dashboard > Project Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Optional; derived from SUPABASE_URL when unset.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Optional: show "Continue with Google" on the sign-in page. Enable the Google provider in
# Supabase (Authentication > Sign In / Providers) first.
# AUTH_GOOGLE_ENABLED=true
